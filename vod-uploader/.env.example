# Telegram API Credentials (from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Default Target Chat / Channel ID (e.g. -100xxxxxxxxxx)
TELEGRAM_CHAT_ID=

# Ziel-Forum Supergruppe für automatische Topic-Sortierung (optional, z. B. -100xxxxxxxxxx)
TELEGRAM_FORUM_CHAT_ID=

# 'true' = weitergeleitete Nachricht als saubere Kopie ohne 'Weitergeleitet von'-Header
FORWARD_DROP_AUTHOR=true

# Parallele Upload-Worker (MTProto-Verbindungen für bis zu 5-fache Upload-Geschwindigkeit, Standard: 6)
PARALLEL_UPLOAD_WORKERS=6
