# Telegram API Credentials (from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Default Target Chat / Channel ID (e.g. -100xxxxxxxxxx)
TELEGRAM_CHAT_ID=

# Ziel-Forum Supergruppe für automatische Topic-Sortierung (optional, z. B. -100xxxxxxxxxx)
TELEGRAM_FORUM_CHAT_ID=

# 'true' = weitergeleitete Nachricht als saubere Kopie ohne 'Weitergeleitet von'-Header
FORWARD_DROP_AUTHOR=true

# Parallele Upload-Worker (MTProto-Verbindungen, Standard: 3 für optimale Balance aus CPU-Last & Speed)
PARALLEL_UPLOAD_WORKERS=3

# Maximale CPU-Threads für ffmpeg beim Teilen großer Videos (>1.8 GB)
FFMPEG_THREADS=2

# Erlaubte Telegram-Nutzer für das Webdashboard (Option B Auth, kommasepariert)
ALLOWED_DASHBOARD_USERS=

# Maximal erlaubte Zeit ohne Datenempfang beim Download in Sekunden (Default: 120 = 2 Minuten)
DOWNLOAD_INACTIVITY_TIMEOUT=120

# Chunk-Groesse im direkten HTTP-Downloader in Bytes (Default: 1048576 = 1 MB)
DOWNLOAD_CHUNK_SIZE=1048576

# --- rss.app Archiv ---
# Archiv aktivieren/deaktivieren
RSS_ENABLED=true

# Pfad zur rss.app-OPML (Export: Profilbild -> Export -> OPML).
# Leer lassen, wenn stattdessen RSS_FEED_URLS genutzt wird.
RSS_OPML_FILE=rss-app-opml.xml

# Nur diese Feed-Titel aus der OPML verwenden (kommagetrennt). Leer = alle Top-Level-Feeds.
# Wird ignoriert, wenn keine OPML geladen wird.
RSS_FEED_TITLES=Gangstolking

# Alternative ohne OPML: direkte Feed-URL(s), eine pro Zeile/kommagetrennt.
# Beispiel: https://rss.app/feeds/xxxxxxxxxxxxxxxx.xml
# Bei Nutzung RSS_OPML_FILE und RSS_FEED_TITLES leer lassen.
RSS_FEED_URLS=

# Persistenter Dedup-State (wird im Container unter /app/rss_data gemountet)
RSS_STATE_FILE=rss_data/rss_state.json

# Poll-Intervall in Sekunden (Developer-Plan aktualisiert Feeds alle 15 Minuten)
RSS_POLL_INTERVAL_SECONDS=900

# Beim ersten Start vorhandene Items NICHT nacharchivieren (true = alles nachladen)
RSS_INITIAL_BACKFILL=false

# Schutz gegen Massen-Backfill nach State-Verlust: Items aelter als X Stunden ignorieren (0 = aus)
RSS_MAX_ITEM_AGE_HOURS=48

# Maximal so viele neue Videos pro Poll verarbeiten (Rest folgt im naechsten Lauf; 0 = unbegrenzt)
RSS_MAX_ITEMS_PER_POLL=10

# Topic-Sortierung pro Quellkanal (dc:creator) im Forum aktivieren
RSS_TOPIC_PER_FEED=true

# Optionales separates Archivziel (leer = TELEGRAM_CHAT_ID / TELEGRAM_FORUM_CHAT_ID)
RSS_ARCHIVE_CHAT_ID=
RSS_ARCHIVE_FORUM_CHAT_ID=

# Optional: Netscape-Cookies fuer yt-dlp (z. B. /app/ytdlp/cookies.txt) - fuer X/YouTube mit Login
YTDLP_COOKIES_FILE=

# Live-Streams waehrend der Ausstrahlung aufnehmen (Standard: aus).
# Bei false bleiben Live/Premieren in der Warteschlange und werden nach Ende nachgeholt.
RSS_ALLOW_LIVE=false

# Retry-Verhalten: 0 = unbegrenzt (empfohlen), >0 = nach so vielen Versuchen endgueltig 'failed'
RSS_MAX_RETRIES=0

# Exponentielles Retry-Backoff: erster Versuch nach X Sekunden, maximal Y Sekunden
RSS_RETRY_BASE_SECONDS=900
RSS_RETRY_MAX_DELAY_SECONDS=21600

# Wie oft ein laufender/angekuendigter Livestream erneut geprueft wird
RSS_LIVE_RECHECK_SECONDS=900

# yt-dlp Downloadgeschwindigkeit: parallele Fragmente, Retries, HTTP-Chunk-Groesse in Bytes
YTDLP_CONCURRENT_FRAGMENTS=4
YTDLP_RETRIES=10
YTDLP_HTTP_CHUNK_SIZE=10485760

# Optional: Format-Limit fuer schnellere Downloads, z. B. bestvideo[height<=1080]+bestaudio/best
YTDLP_FORMAT=

# n8n-Workflows per Dashboard-Button starten.
# Format: name=webhook-url, mehrere per Komma. Leer = Buttons werden ausgeblendet.
N8N_WEBHOOKS=karbfenchieff=http://n8n:5678/webhook/vod-karbfenchieff,karpfenchieff=http://n8n:5678/webhook/vod-karpfenchieff,ripperchieff=http://n8n:5678/webhook/vod-ripperchieff
# Timeout pro Webhook-Aufruf in Sekunden
N8N_WEBHOOK_TIMEOUT=10
# Sperrzeit pro Workflow gegen Doppelklicks in Sekunden
N8N_TRIGGER_COOLDOWN=10

